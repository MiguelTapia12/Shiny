# ==============================================================================
# .env.example - Configuración de Entorno para la Aplicación Breeding
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo a `.Renviron` (para R/Shiny) y a `.env` (si usas Docker).
# Configura las variables según tu entorno de despliegue.

# --- SEGURIDAD DE LA API ---
# Token secreto que deben enviar las tablets en el header Authorization
# Ej: Un UUID o una clave fuerte alfanumérica.
BREEDING_API_TOKEN=CambiarPorUnTokenSeguroEnProduccion

# --- BASE DE DATOS ---
# Define el tipo de base de datos a usar.
# Valores permitidos: 'sqlite', 'postgres'
DB_TYPE=sqlite

# --- CONFIGURACIÓN DE POSTGRESQL (Opcional) ---
# Solo se requiere si DB_TYPE=postgres
DB_NAME=breeding_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario_postgres
DB_PASS=tu_contraseña_segura

# --- VARIABLES DE ENTORNO SHINY ---
# Puerto en el que la aplicación de Shiny y la API escucharán (por defecto 8000 o 3838)
PORT=8000
# Define si el entorno es de desarrollo o producción
APP_ENV=production

